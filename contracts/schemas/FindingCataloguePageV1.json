{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.invalid/contracts/FindingCataloguePageV1.json",
  "title": "FindingCataloguePageV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "scope": {
      "type": "string",
      "const": "retained_static_observations"
    },
    "result_set_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "retained_result_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "jobs_without_result": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "result_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "document": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "type": "string",
              "const": "1.0"
            },
            "owner_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "job_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "request_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "app_id": {
              "type": "string",
              "const": "app_demo"
            },
            "repository_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "map_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "tool_lock_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "snapshot_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "status": {
              "type": "string",
              "enum": [
                "completed",
                "completed_partial",
                "completed_stale_db",
                "tool_error"
              ]
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "tool_id": {
                    "type": "string",
                    "enum": [
                      "semgrep_ce",
                      "osv_v2",
                      "trivy",
                      "syft",
                      "gitleaks",
                      "bandit"
                    ]
                  },
                  "receipt_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "completed",
                      "completed_partial",
                      "completed_stale_db",
                      "tool_error"
                    ]
                  },
                  "finding_claims": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "has_sbom": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "tool_id",
                  "receipt_digest",
                  "status",
                  "finding_claims",
                  "has_sbom"
                ]
              },
              "minItems": 1,
              "maxItems": 6
            },
            "finding_claims": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60000
            },
            "has_partial": {
              "type": "boolean"
            },
            "has_stale_database": {
              "type": "boolean"
            },
            "has_tool_error": {
              "type": "boolean"
            },
            "evidence_tier": {
              "type": "string",
              "const": "T0"
            },
            "cleanup_required": {
              "type": "boolean",
              "const": true
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "schema_version",
            "owner_id",
            "job_id",
            "request_digest",
            "app_id",
            "repository_id",
            "map_digest",
            "tool_lock_digest",
            "snapshot_digest",
            "status",
            "tools",
            "finding_claims",
            "has_partial",
            "has_stale_database",
            "has_tool_error",
            "evidence_tier",
            "cleanup_required",
            "created_at"
          ]
        }
      },
      "required": [
        "result_digest",
        "document"
      ]
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "job_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "request_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "result_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "snapshot_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "completed_partial",
            "completed_stale_db",
            "tool_error"
          ]
        },
        "has_partial": {
          "type": "boolean"
        },
        "has_stale_database": {
          "type": "boolean"
        },
        "has_tool_error": {
          "type": "boolean"
        },
        "tool_claims": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "distinct_static_claims": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "matching_static_claims": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "record_id": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "finding": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "schema_version": {
                    "type": "string",
                    "const": "1.0"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "app_id": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "repository_id": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "static_pattern",
                      "secret_candidate",
                      "known_vulnerable_dependency",
                      "configuration_claim"
                    ]
                  },
                  "summary": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "suspected",
                      "corroborated",
                      "reproduced",
                      "remediating",
                      "fixed_or_mitigated",
                      "monitored"
                    ]
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "informational",
                      "low",
                      "medium",
                      "high",
                      "critical"
                    ]
                  },
                  "confidence": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "evidence_tier": {
                    "type": "string",
                    "enum": [
                      "T0",
                      "T1",
                      "T2",
                      "T3",
                      "T4",
                      "T5"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000000
                  },
                  "package_name": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "package_url": {
                    "type": "string",
                    "maxLength": 1024
                  },
                  "installed_version": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "advisories": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "maxItems": 64
                  },
                  "secret_fingerprint": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "provenance": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "tool_id": {
                          "type": "string",
                          "maxLength": 32
                        },
                        "tool_version": {
                          "type": "string",
                          "maxLength": 64
                        },
                        "tool_image_digest": {
                          "type": "string",
                          "pattern": "^sha256:[0-9a-f]{64}$"
                        },
                        "parser_version": {
                          "type": "string",
                          "enum": [
                            "1.0",
                            "1.1",
                            "1.2"
                          ]
                        },
                        "input_digest": {
                          "type": "string",
                          "pattern": "^sha256:[0-9a-f]{64}$"
                        },
                        "rule_id": {
                          "type": "string",
                          "maxLength": 160
                        },
                        "severity_claimed": {
                          "type": "string",
                          "enum": [
                            "informational",
                            "low",
                            "medium",
                            "high",
                            "critical"
                          ]
                        }
                      },
                      "required": [
                        "tool_id",
                        "tool_version",
                        "tool_image_digest",
                        "parser_version",
                        "input_digest"
                      ]
                    },
                    "minItems": 1,
                    "maxItems": 16
                  },
                  "coverage_note": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "created_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "schema_version",
                  "id",
                  "app_id",
                  "repository_id",
                  "category",
                  "summary",
                  "status",
                  "severity",
                  "confidence",
                  "evidence_tier",
                  "provenance",
                  "coverage_note",
                  "created_at"
                ]
              },
              "receipt_digests": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "minItems": 1,
                "maxItems": 6,
                "uniqueItems": true
              },
              "owner_review": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "triage_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "document": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "schema_version": {
                        "type": "string",
                        "const": "1.0"
                      },
                      "owner_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "job_id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                      },
                      "record_id": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      },
                      "result_digest": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      },
                      "revision": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 50
                      },
                      "state": {
                        "type": "string",
                        "enum": [
                          "suspected",
                          "unverified",
                          "false_positive",
                          "accepted_risk"
                        ]
                      },
                      "rationale": {
                        "type": "string",
                        "maxLength": 512
                      },
                      "previous_digest": {
                        "type": "string",
                        "pattern": "^(|sha256:[0-9a-f]{64})$"
                      },
                      "updated_at": {
                        "type": "string",
                        "maxLength": 64
                      }
                    },
                    "required": [
                      "schema_version",
                      "owner_id",
                      "job_id",
                      "record_id",
                      "result_digest",
                      "revision",
                      "state",
                      "rationale",
                      "previous_digest",
                      "updated_at"
                    ]
                  }
                },
                "required": [
                  "triage_digest",
                  "document"
                ]
              }
            },
            "required": [
              "record_id",
              "finding",
              "receipt_digests"
            ]
          },
          "maxItems": 20
        },
        "next_cursor": {
          "type": "string",
          "maxLength": 512
        }
      },
      "required": [
        "schema_version",
        "owner_id",
        "job_id",
        "request_digest",
        "result_digest",
        "snapshot_digest",
        "status",
        "has_partial",
        "has_stale_database",
        "has_tool_error",
        "tool_claims",
        "distinct_static_claims",
        "matching_static_claims",
        "items",
        "next_cursor"
      ]
    },
    "next_cursor": {
      "type": "string",
      "maxLength": 2048
    }
  },
  "required": [
    "schema_version",
    "owner_id",
    "scope",
    "result_set_digest",
    "retained_result_count",
    "jobs_without_result",
    "result_index",
    "next_cursor"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "retained_result_count": {
            "const": 0
          }
        }
      },
      "then": {
        "properties": {
          "result_index": {
            "const": 0
          },
          "next_cursor": {
            "const": ""
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "result"
              ]
            },
            {
              "required": [
                "findings"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "result",
          "findings"
        ]
      }
    }
  ]
}
