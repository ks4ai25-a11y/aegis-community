{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.invalid/contracts/ScannerEngineJournalBindingV1.json",
  "title": "ScannerEngineJournalBindingV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "journal_binding_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "engine_binding_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "journal_root_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "journal_namespace_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schema_version",
        "owner_id",
        "engine_binding_digest",
        "journal_root_digest",
        "journal_namespace_digest",
        "created_at"
      ]
    }
  },
  "required": [
    "journal_binding_digest",
    "document"
  ]
}
