{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.invalid/contracts/VerificationReportV1.json",
  "title": "VerificationReportV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "report_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "test_scope": {
      "type": "string",
      "const": "bundled-synthetic-fixture"
    },
    "scope_grant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "scope_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "claim_level": {
      "type": "string",
      "const": "LEVEL_1_CONTROL_TEST"
    },
    "fixture_id": {
      "type": "string",
      "const": "crs-synthetic-sqli-pattern-v1"
    },
    "fixture_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "baseline_policy_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "candidate_policy_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gateway_binary_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "control-allowed",
              "negative-matched-and-mode-correct"
            ]
          },
          "result": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "INCONCLUSIVE"
            ]
          },
          "baseline_http_status": {
            "type": "integer",
            "minimum": 0,
            "maximum": 599
          },
          "candidate_http_status": {
            "type": "integer",
            "minimum": 0,
            "maximum": 599
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]{1,10}$"
            },
            "maxItems": 64
          },
          "baseline_rule_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]{1,10}$"
            },
            "maxItems": 64
          }
        },
        "required": [
          "id",
          "result",
          "baseline_http_status",
          "candidate_http_status",
          "rule_ids"
        ]
      },
      "minItems": 2,
      "maxItems": 2
    },
    "overall": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512
      },
      "minItems": 1,
      "maxItems": 16
    },
    "canonical_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "report_id",
    "test_scope",
    "claim_level",
    "fixture_id",
    "fixture_digest",
    "baseline_policy_digest",
    "candidate_policy_digest",
    "gateway_binary_digest",
    "started_at",
    "completed_at",
    "checks",
    "overall",
    "limitations",
    "canonical_sha256"
  ]
}
