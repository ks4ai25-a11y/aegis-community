{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.invalid/contracts/ScannerBrokerDispatchOutcomeV1.json",
  "title": "ScannerBrokerDispatchOutcomeV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "state": {
      "type": "string",
      "enum": [
        "not_claimed",
        "no_job",
        "stopped",
        "finalization_unconfirmed",
        "completed",
        "completed_partial",
        "completed_stale_db",
        "tool_error"
      ]
    },
    "job_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "result_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "receipt_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "all_engine_writes_mediated": {
      "type": "boolean",
      "const": false
    },
    "cleanup_release_authorized": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "schema_version",
    "state",
    "receipt_count",
    "all_engine_writes_mediated",
    "cleanup_release_authorized"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "not_claimed",
              "no_job"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "receipt_count": {
            "const": 0
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "job_id"
              ]
            },
            {
              "required": [
                "request_digest"
              ]
            },
            {
              "required": [
                "result_digest"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "completed",
              "completed_partial",
              "completed_stale_db",
              "tool_error"
            ]
          }
        }
      },
      "then": {
        "required": [
          "job_id",
          "request_digest",
          "result_digest"
        ],
        "properties": {
          "receipt_count": {
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "stopped",
              "finalization_unconfirmed"
            ]
          }
        }
      },
      "then": {
        "required": [
          "job_id",
          "request_digest"
        ],
        "not": {
          "required": [
            "result_digest"
          ]
        }
      }
    }
  ]
}
