{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.invalid/contracts/FindingPageV1.json",
  "title": "FindingPageV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "job_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "result_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "snapshot_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "completed_partial",
        "completed_stale_db",
        "tool_error"
      ]
    },
    "has_partial": {
      "type": "boolean"
    },
    "has_stale_database": {
      "type": "boolean"
    },
    "has_tool_error": {
      "type": "boolean"
    },
    "tool_claims": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60000
    },
    "distinct_static_claims": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60000
    },
    "matching_static_claims": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60000
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "record_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "finding": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "schema_version": {
                "type": "string",
                "const": "1.0"
              },
              "id": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "app_id": {
                "type": "string",
                "maxLength": 128
              },
              "repository_id": {
                "type": "string",
                "maxLength": 128
              },
              "category": {
                "type": "string",
                "enum": [
                  "static_pattern",
                  "secret_candidate",
                  "known_vulnerable_dependency",
                  "configuration_claim"
                ]
              },
              "summary": {
                "type": "string",
                "maxLength": 512
              },
              "status": {
                "type": "string",
                "enum": [
                  "suspected",
                  "corroborated",
                  "reproduced",
                  "remediating",
                  "fixed_or_mitigated",
                  "monitored"
                ]
              },
              "severity": {
                "type": "string",
                "enum": [
                  "informational",
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "evidence_tier": {
                "type": "string",
                "enum": [
                  "T0",
                  "T1",
                  "T2",
                  "T3",
                  "T4",
                  "T5"
                ]
              },
              "path": {
                "type": "string",
                "maxLength": 512
              },
              "line": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              },
              "package_name": {
                "type": "string",
                "maxLength": 256
              },
              "package_url": {
                "type": "string",
                "maxLength": 1024
              },
              "installed_version": {
                "type": "string",
                "maxLength": 128
              },
              "advisories": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 128
                },
                "maxItems": 64
              },
              "secret_fingerprint": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "provenance": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "tool_id": {
                      "type": "string",
                      "maxLength": 32
                    },
                    "tool_version": {
                      "type": "string",
                      "maxLength": 64
                    },
                    "tool_image_digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "parser_version": {
                      "type": "string",
                      "enum": [
                        "1.0",
                        "1.1",
                        "1.2"
                      ]
                    },
                    "input_digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "rule_id": {
                      "type": "string",
                      "maxLength": 160
                    },
                    "severity_claimed": {
                      "type": "string",
                      "enum": [
                        "informational",
                        "low",
                        "medium",
                        "high",
                        "critical"
                      ]
                    }
                  },
                  "required": [
                    "tool_id",
                    "tool_version",
                    "tool_image_digest",
                    "parser_version",
                    "input_digest"
                  ]
                },
                "minItems": 1,
                "maxItems": 16
              },
              "coverage_note": {
                "type": "string",
                "maxLength": 512
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "schema_version",
              "id",
              "app_id",
              "repository_id",
              "category",
              "summary",
              "status",
              "severity",
              "confidence",
              "evidence_tier",
              "provenance",
              "coverage_note",
              "created_at"
            ]
          },
          "receipt_digests": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true
          }
        },
        "required": [
          "record_id",
          "finding",
          "receipt_digests"
        ]
      },
      "maxItems": 20
    },
    "next_cursor": {
      "type": "string",
      "maxLength": 512
    }
  },
  "required": [
    "schema_version",
    "owner_id",
    "job_id",
    "request_digest",
    "result_digest",
    "snapshot_digest",
    "status",
    "has_partial",
    "has_stale_database",
    "has_tool_error",
    "tool_claims",
    "distinct_static_claims",
    "matching_static_claims",
    "items",
    "next_cursor"
  ]
}
