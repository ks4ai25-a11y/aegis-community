        "tool_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "semgrep_ce",
              "osv_v2",
              "trivy",
              "syft",
              "gitleaks",
              "bandit"
            ]
          },
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true
        },
        "workspaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "workspace_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
