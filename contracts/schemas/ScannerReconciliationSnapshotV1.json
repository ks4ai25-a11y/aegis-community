                  "guard_set_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "guard_protocol": {
                    "type": "string",
                    "const": "absolute-deadline-v1"
                  }
                },
                "required": [
                  "schema_version",
                  "owner_id",
                  "job_id",
                  "request_digest",
                  "app_id",
                  "repository_id",
                  "map_digest",
                  "tool_lock_digest",
                  "tool_version",
                  "tool_image_digest",
                  "sandbox_profile",
                  "duration_limit_seconds",
                  "plan",
                  "created_at",
                  "deadline",
                  "guard_set_digest",
                  "guard_protocol"
                ]
              }
            },
            "required": [
              "launch_digest",
              "document"
            ]
          },
          "maxItems": 6
        },
        "mutations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "intent_id": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "request": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "generation_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "job_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "tool_id": {
                    "type": "string",
                    "enum": [
                      "semgrep_ce",
                      "osv_v2",
                      "trivy",
                      "syft",
                      "gitleaks",
                      "bandit"
                    ]
                  },
                  "operation": {
                    "type": "string",
                    "enum": [
                      "create",
                      "start",
                      "remove"
                    ]
                  },
                  "launch_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "descriptor_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "target_engine_id": {
                    "type": "string",
                    "pattern": "^(|[0-9a-f]{64})$"
                  }
                },
                "required": [
                  "generation_id",
                  "job_id",
                  "tool_id",
                  "operation",
                  "launch_digest",
                  "descriptor_digest",
                  "target_engine_id"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "operation": {
                          "const": "create"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "target_engine_id": {
                          "const": ""
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "target_engine_id": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      }
                    }
                  }
                ]
              },
              "workspace_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "container": {
                "type": "string",
                "pattern": "^aegis-scan-[0-9a-f]{32}$"
              },
              "state": {
                "type": "string",
                "enum": [
                  "pending",
                  "completed"
                ]
              },
              "response_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "response_status": {
                "type": "integer",
                "minimum": 201,
                "maximum": 204
              },
              "result_engine_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "intent_id",
              "request",
              "workspace_digest",
              "container",
              "state"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "state": {
                      "const": "pending"
                    }
                  }
                },
                "then": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "response_digest"
                        ]
                      },
                      {
                        "required": [
                          "response_status"
                        ]
                      },
                      {
                        "required": [
                          "result_engine_id"
                        ]
                      }
                    ]
                  }
                },
                "else": {
                  "required": [
                    "response_digest",
                    "response_status",
                    "result_engine_id"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "request": {
                      "properties": {
                        "operation": {
                          "const": "create"
                        }
                      }
                    },
                    "state": {
                      "const": "completed"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "response_status": {
                      "const": 201
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "request": {
                      "properties": {
                        "operation": {
                          "enum": [
                            "start",
                            "remove"
                          ]
                        }
                      }
                    },
                    "state": {
                      "const": "completed"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "response_status": {
                      "const": 204
                    }
                  }
                }
              }
            ]
          },
          "maxItems": 18
        }
      },
      "required": [
        "owner_id",
        "job_id",
        "request_digest",
        "app_id",
        "repository_id",
        "map_digest",
        "tool_lock_digest",
        "duration_limit_seconds",
        "job_created_at",
        "job_state",
        "cancel_requested",
        "binding",
        "generation",
        "worker_id",
        "dispatch_state",
        "lease_until_unix",
        "dispatch_fingerprint",
        "guard_set_digest",
        "tool_ids",
        "workspaces",
        "launches",
        "mutations"
      ]
    },
    "metadata_only": {
      "type": "boolean",
      "const": true
    },
    "cleanup_required": {
      "type": "boolean",
      "const": true
    },
    "cleanup_release_authorized": {
      "type": "boolean",
      "const": false
    },
    "engine_writes_authorized": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "schema_version",
    "reconciler_id",
    "challenge",
    "observed_at",
    "membership_digest",
    "membership",
    "metadata_only",
    "cleanup_required",
    "cleanup_release_authorized",
    "engine_writes_authorized"
  ]
}
