              "document": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "schema_version": {
                    "type": "string",
                    "const": "1.0"
                  },
                  "owner_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "job_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "request_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "app_id": {
                    "type": "string",
                    "const": "app_demo"
                  },
                  "repository_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "map_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
