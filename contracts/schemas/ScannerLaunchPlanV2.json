{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.invalid/contracts/ScannerLaunchPlanV2.json",
  "title": "ScannerLaunchPlanV2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tool_id": {
      "type": "string",
      "enum": [
        "semgrep_ce",
        "osv_v2",
        "trivy",
        "syft",
        "gitleaks",
        "bandit"
      ]
    },
    "container_id": {
      "type": "string",
      "pattern": "^aegis-scan-[0-9a-f]{32}$"
    },
    "engine_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^run-[0-9a-f]{32}$"
    },
    "registry_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "snapshot_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "guard_binary_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "guard_architecture": {
      "type": "string",
      "enum": [
        "amd64",
        "arm64"
      ]
    }
  },
  "required": [
    "tool_id",
    "container_id",
    "engine_digest",
    "workspace_id",
    "registry_digest",
    "snapshot_digest",
    "guard_binary_digest",
    "guard_architecture"
  ]
}
