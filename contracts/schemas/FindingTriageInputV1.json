{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.invalid/contracts/FindingTriageInputV1.json",
  "title": "FindingTriageInputV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "record_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "result_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 49
    },
    "state": {
      "type": "string",
      "enum": [
        "suspected",
        "unverified",
        "false_positive",
        "accepted_risk"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 5,
      "maxLength": 512
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "result_digest",
    "expected_revision",
    "state",
    "rationale"
  ]
}
