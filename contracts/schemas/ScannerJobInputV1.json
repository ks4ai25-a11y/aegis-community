{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.invalid/contracts/ScannerJobInputV1.json",
  "title": "ScannerJobInputV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "app_id": {
      "type": "string",
      "const": "app_demo"
    },
    "repository_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "map_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mode": {
      "type": "string",
      "const": "repo_offline"
    },
    "tool_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "semgrep_ce",
          "osv_v2",
          "trivy",
          "syft",
          "gitleaks",
          "bandit"
        ]
      },
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true
    },
    "tool_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "advisory_database_digests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "osv_v2": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "trivy": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": []
    }
  },
  "required": [
    "schema_version",
    "app_id",
    "repository_id",
    "map_digest",
    "mode",
    "tool_ids",
    "tool_timeout_seconds"
  ]
}
