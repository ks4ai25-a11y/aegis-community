            "app_id": {
              "type": "string",
              "const": "app_demo"
            },
            "repository_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "map_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "tool_lock_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
