{
  "openapi": "3.1.0",
  "info": {
    "title": "Aegis scoped research API",
    "version": "0.1.0-alpha.1",
    "description": "Implemented provisioned read-only repositories, offline scanner jobs/results and bundled test_lab surface only. This is not the complete v4 API catalogue."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:7410/api/v1"
    }
  ],
  "paths": {
    "/findings/catalogue": {
      "get": {
        "operationId": "listFindingCatalogue",
        "security": [
          {
            "ownerSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful owner-scoped operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FindingCataloguePageV1"
                }
              }
            }
          },
          "default": {
            "description": "Typed failure; never a success or clean-scan conclusion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelopeV1"
                }
              }
            }
          }
        },
        "x-query-schema": "FindingCatalogueQueryV1",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "maxLength": 64
            }
          },
          {
            "name": "until",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "maxLength": 64
            }
          },
          {
            "name": "repository_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "static_pattern",
                "secret_candidate",
                "known_vulnerable_dependency"
              ]
            }
          },
          {
            "name": "severity",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "informational",
                "low",
                "medium",
                "high",
                "critical"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          }
        ]
      }
    },
